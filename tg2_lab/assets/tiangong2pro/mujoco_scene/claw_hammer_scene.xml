    </body>

    <body name="claw_hammer" pos="0.00 0.50 0.56">
      <freejoint name="claw_hammer_freejoint"/>
      <!-- Match the reference MuJoCo sim2sim proxy shape: detailed OBJ is
           visual-only, while contact uses a stable box handle plus capsule
           head shifted into the DexToolBench OBJ frame. -->
      <geom name="hammer_visual_mesh_geom" type="mesh" mesh="claw_hammer_mesh" material="claw_hammer_mat" density="0" group="1" contype="0" conaffinity="0"/>
      <geom name="hammer_handle_collision_proxy" type="box" pos="0.0261 -0.0008 0.0003" size="0.10 0.015 0.01" rgba="0.5 0.5 0.5 0.35" density="400" condim="6" friction="1 0.005 0.0001" group="3" contype="1" conaffinity="1"/>
      <geom name="hammer_head_collision_proxy" type="capsule" fromto="0.1242 -0.0254 -0.0004 0.1242 0.0346 -0.0004" size="0.02" rgba="0.4 0.4 0.4 0.35" density="300" condim="6" friction="1 0.005 0.0001" group="3" contype="1" conaffinity="1"/>
      <site name="hammer_keypoint_0" type="sphere" pos="0.075 0.016875 0.01125" size="0.008" rgba="0.1 0.45 1.0 1"/>
      <site name="hammer_keypoint_1" type="sphere" pos="0.075 0.016875 -0.01125" size="0.008" rgba="0.1 0.45 1.0 1"/>
      <site name="hammer_keypoint_2" type="sphere" pos="-0.075 -0.016875 0.01125" size="0.008" rgba="0.1 0.45 1.0 1"/>
      <site name="hammer_keypoint_3" type="sphere" pos="-0.075 -0.016875 -0.01125" size="0.008" rgba="0.1 0.45 1.0 1"/>
    </body>

    <body name="goal_claw_hammer" mocap="true" pos="0.00 0.50 0.86">
      <geom name="goal_hammer_mesh_geom" type="mesh" mesh="claw_hammer_mesh" material="goal_hammer_mat" contype="0" conaffinity="0"/>
      <site name="goal_position" type="sphere" pos="0 0 0" size="0.012" rgba="0.1 1.0 0.25 1"/>
      <site name="goal_keypoint_0" type="sphere" pos="0.075 0.016875 0.01125" size="0.008" rgba="0.1 1.0 0.25 1"/>
      <site name="goal_keypoint_1" type="sphere" pos="0.075 0.016875 -0.01125" size="0.008" rgba="0.1 1.0 0.25 1"/>
      <site name="goal_keypoint_2" type="sphere" pos="-0.075 -0.016875 0.01125" size="0.008" rgba="0.1 1.0 0.25 1"/>
      <site name="goal_keypoint_3" type="sphere" pos="-0.075 -0.016875 -0.01125" size="0.008" rgba="0.1 1.0 0.25 1"/>
    </body>
