    <material name="goal_hammer_mat" rgba="0.1 0.9 0.25 0.28"/>
  </asset>

  <worldbody>
    <camera name="validation_front" pos="0 2.25 1.10" xyaxes="-1 0 0 0 -0.32 0.95"/>

    <body name="table" pos="0.00 0.58 0.515">
