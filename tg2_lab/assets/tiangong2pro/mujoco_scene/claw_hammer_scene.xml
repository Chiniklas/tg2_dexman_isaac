<mujoco model="tiangong2pro_claw_hammer_scene">
  <compiler meshdir="../meshes" texturedir="../textures"/>

  <include file="../xml/tiangong2.0_pro_with_hands_half_body.xml"/>

  <option gravity="0 0 -9.81" timestep="0.001" integrator="implicit" solver="Newton" iterations="80" ls_iterations="20">
    <flag limit="enable"/>
  </option>

  <asset>
    <mesh name="claw_hammer_mesh" file="dextoolbench/claw_hammer.obj"/>
    <texture name="claw_hammer_texture" type="2d" file="dextoolbench/claw_hammer_material_0.png"/>
