<?xml version="1.0"?>
<package format="3">
  <name>feedback_control_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 direct joint command and status bridge for Tiangong arm and hand control.</description>
  <maintainer email="robotics@tiangong.example">Tiangong Robotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>bodyctrl_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
